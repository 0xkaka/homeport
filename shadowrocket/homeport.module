#!name=homeport
#!desc=Claude、Google、支付与风控域名走备注为 HP_Home 的住宅节点

[Rule]
# Anthropic IPv6 段经住宅代理会 502，先拒掉，客户端会自动回落 IPv4
IP-CIDR6,2607:6bc0::/48,REJECT,no-resolve
IP-CIDR6,2607:6bc0:11::/48,REJECT,no-resolve

# Claude / Anthropic
